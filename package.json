{
  "name": "@jaycou/codex-history-rail",
  "version": "1.0.0",
  "description": "Codex History Rail — a Codex-style turn rail for the current DSH conversation, with hover previews, click-to-jump, and favorites.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JAYCou/codex-history-rail.git"
  },
  "homepage": "https://github.com/JAYCou/codex-history-rail#readme",
  "icon": "./icon.svg",
  "type": "module",
  "engines": {
    "dsh": ">=0.2.1-rc.3 <0.3.0-0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  }
}
